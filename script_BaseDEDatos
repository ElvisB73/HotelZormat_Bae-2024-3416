-- HotelZormat - Script de base de datos

-- 1. CREACION DE LA BASE DE DATOS

IF EXISTS (SELECT name FROM sys.databases WHERE name = 'HotelBae')
BEGIN
    ALTER DATABASE HotelBae SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE HotelBae;
END
GO

CREATE DATABASE HotelBae;
GO

USE HotelBae;
GO

-- 2. TABLA: Usuarios
CREATE TABLE Usuarios (
    UsuarioId        INT IDENTITY(1,1) PRIMARY KEY,
    NombreUsuario    VARCHAR(50)  NOT NULL UNIQUE,
    ContrasenaHash   VARCHAR(64)  NOT NULL,
    NombreCompleto   VARCHAR(100) NOT NULL,
    Rol              VARCHAR(20)  NOT NULL,
    Activo           BIT          NOT NULL DEFAULT 1,
    FechaCreacion    DATETIME     NOT NULL DEFAULT GETDATE(),
    CONSTRAINT CK_Usuarios_Rol CHECK (Rol IN ('Administrador', 'Recepcionista'))
);
GO

-- 3. TABLA: Habitaciones
CREATE TABLE Habitaciones (
    HabitacionId     INT IDENTITY(1,1) PRIMARY KEY,
    Numero           INT            NOT NULL UNIQUE,
    Piso             INT            NOT NULL,
    Tipo             VARCHAR(30)    NOT NULL,
    Capacidad        INT            NOT NULL,
    TarifaBase       DECIMAL(10,2)  NOT NULL,
    Estado           VARCHAR(15)    NOT NULL DEFAULT 'Disponible',
    CONSTRAINT CK_Habitaciones_Estado CHECK (Estado IN ('Disponible', 'Ocupada', 'Reservada', 'Limpieza'))
);
GO

-- 4. TABLA: Huespedes
CREATE TABLE Huespedes (
    HuespedId        INT IDENTITY(1,1) PRIMARY KEY,
    TipoDocumento    VARCHAR(10)   NOT NULL,
    NumeroDocumento  VARCHAR(20)   NOT NULL UNIQUE,
    Nombre           VARCHAR(50)   NOT NULL,
    Apellido         VARCHAR(50)   NOT NULL,
    Nacionalidad     VARCHAR(50)   NULL,
    Telefono         VARCHAR(20)   NULL,
    Email            VARCHAR(100)  NULL,
    FechaRegistro    DATETIME      NOT NULL DEFAULT GETDATE(),
    CONSTRAINT CK_Huespedes_TipoDocumento CHECK (TipoDocumento IN ('Cedula', 'Pasaporte'))
);
GO

-- 5. TABLA: Reservas
CREATE TABLE Reservas (
    ReservaId        INT IDENTITY(1,1) PRIMARY KEY,
    HabitacionId     INT            NOT NULL,
    HuespedId        INT            NOT NULL,
    FechaCheckIn     DATETIME       NOT NULL,
    FechaCheckOut    DATETIME       NOT NULL,
    Temporada        VARCHAR(10)    NOT NULL,
    TotalNoches      INT            NOT NULL,
    MontoTotal       DECIMAL(10,2)  NOT NULL,
    Estado           VARCHAR(15)    NOT NULL DEFAULT 'Pendiente',
    FechaCreacion    DATETIME       NOT NULL DEFAULT GETDATE(),
    CONSTRAINT FK_Reservas_Habitaciones FOREIGN KEY (HabitacionId) REFERENCES Habitaciones(HabitacionId),
    CONSTRAINT FK_Reservas_Huespedes FOREIGN KEY (HuespedId) REFERENCES Huespedes(HuespedId),
    CONSTRAINT CK_Reservas_Temporada CHECK (Temporada IN ('Alta', 'Media', 'Baja')),
    CONSTRAINT CK_Reservas_Estado CHECK (Estado IN ('Pendiente', 'Confirmada', 'Cancelada')),
    CONSTRAINT CK_Reservas_Fechas CHECK (FechaCheckOut > FechaCheckIn)
);
GO

-- 6. TABLA: Estadias
CREATE TABLE Estadias (
    EstadiaId          INT IDENTITY(1,1) PRIMARY KEY,
    ReservaId           INT       NOT NULL,
    HabitacionId         INT       NOT NULL,
    HuespedId            INT       NOT NULL,
    FechaCheckInReal     DATETIME  NOT NULL DEFAULT GETDATE(),
    FechaCheckOutReal    DATETIME  NULL,
    Estado               VARCHAR(10) NOT NULL DEFAULT 'Activa',
    CONSTRAINT FK_Estadias_Reservas FOREIGN KEY (ReservaId) REFERENCES Reservas(ReservaId),
    CONSTRAINT FK_Estadias_Habitaciones FOREIGN KEY (HabitacionId) REFERENCES Habitaciones(HabitacionId),
    CONSTRAINT FK_Estadias_Huespedes FOREIGN KEY (HuespedId) REFERENCES Huespedes(HuespedId),
    CONSTRAINT CK_Estadias_Estado CHECK (Estado IN ('Activa', 'Cerrada'))
);
GO

-- 7. TABLA: NumeracionNCF
CREATE TABLE NumeracionNCF (
    TipoNCF        VARCHAR(5)  PRIMARY KEY,
    UltimoNumero   INT         NOT NULL
);
GO

-- 8. TABLA: Facturas
CREATE TABLE Facturas (
    FacturaId        INT IDENTITY(1,1) PRIMARY KEY,
    EstadiaId        INT            NOT NULL,
    NCF              VARCHAR(19)    NOT NULL UNIQUE,
    Subtotal         DECIMAL(10,2)  NOT NULL,
    ITBIS            DECIMAL(10,2)  NOT NULL,
    Propina          DECIMAL(10,2)  NOT NULL,
    Total            DECIMAL(10,2)  NOT NULL,
    FechaEmision     DATETIME       NOT NULL DEFAULT GETDATE(),
    CONSTRAINT FK_Facturas_Estadias FOREIGN KEY (EstadiaId) REFERENCES Estadias(EstadiaId)
);
GO

-- 9. TABLA: Bitacora
CREATE TABLE Bitacora (
    BitacoraId       INT IDENTITY(1,1) PRIMARY KEY,
    UsuarioId        INT           NOT NULL,
    Accion           VARCHAR(50)   NOT NULL,
    Detalle          VARCHAR(200)  NULL,
    FechaHora        DATETIME      NOT NULL DEFAULT GETDATE(),
    CONSTRAINT FK_Bitacora_Usuarios FOREIGN KEY (UsuarioId) REFERENCES Usuarios(UsuarioId)
);
GO

